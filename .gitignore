# --- Virtual environments (venv lives at %USERPROFILE%\sparkrl_env, see DECISIONS.md DEC-001) ---
.venv/
venv/
env/

# --- Python build/test caches ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Heavy/generated artifacts (bulk data lives in external SPARKRL_DATA_ROOT) ---
data/**
!data/**/
!data/**/.gitkeep
results/**
!results/**/
!results/**/.gitkeep
# EXP-002 (Day 22) exception: the raw run manifests, the pre-registered spec snapshot,
# the attempt log and the gate result ARE the scientific record of the sensitivity gate.
# They are small (~2 MB of JSON) and are kept under version control so the PASS/FAIL
# verdict is reproducible from the repository alone. Spark event logs and datasets stay
# outside the repo (DEC-002) and are still excluded.
!results/experiments/exp-002/**/*.json
!results/experiments/exp-002/**/*.md
!results/experiments/exp-002/attempts.jsonl
# Day-31 evaluation freeze exception (DEC-013): the TEST-split identity freeze and
# the evaluation specification are the artifacts Days 32-34 must verify their
# fingerprints against. Like the EXP-002 record they are small JSON and belong in
# version control, or the freeze is not reproducible from the repository alone.
# Measured evaluation OBSERVATIONS are not covered here and stay excluded.
!results/evaluation/*.json
logs/**
!logs/**/
!logs/**/.gitkeep
plots/**
!plots/**/
!plots/**/.gitkeep

# --- Spark artifacts (defensive; bulk lives in the external data root) ---
spark-warehouse/
metastore_db/
derby.log
spark-events/
*.inprogress

# --- Models: small policy JSONs are tracked; large binary artifacts are not ---
models/**/*.pkl
models/**/*.pt
models/**/*.joblib
models/**/*.ckpt

# --- IDE / OS / OneDrive noise ---
.vscode/
.idea/
*.code-workspace
Thumbs.db
desktop.ini
~$*
